{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patient-feather-4523",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "belaruski-kosh-staging",
      "database_id": "980e4ce8-5d23-4015-9675-5ea4ba134840"
    }
  ],
  "build": {
    "command": "node node_modules/vinext/dist/cli.js build"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
