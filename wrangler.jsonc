{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patient-feather-4523",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "belaruski-kosh.org",
      "custom_domain": true,
    },
  ],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "belaruski-kosh-production",
      "database_id": "4c2e5540-bf48-45c2-89ad-648b211bbbf2",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "LOGOS",
      "bucket_name": "kosh-production-logos",
    },
  ],
  "build": {
    "command": "node node_modules/vinext/dist/cli.js build",
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
